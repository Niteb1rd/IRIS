<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Iris.App.Views">

    <SolidColorBrush x:Key="Iris.WindowBack" Color="#202020" />
    <SolidColorBrush x:Key="Iris.Text" Color="#E8E8E8" />
    <SolidColorBrush x:Key="Iris.Hint" Color="#A8A8A8" />
    <SolidColorBrush x:Key="Iris.Error" Color="#FF7B72" />
    <SolidColorBrush x:Key="Iris.Note" Color="#E8A33C" />
    <SolidColorBrush x:Key="Iris.Valid" Color="#6CCB70" />
    <SolidColorBrush x:Key="Iris.BannerBack" Color="#3B1E1E" />
    <SolidColorBrush x:Key="Iris.BannerBorder" Color="#C62828" />
    <SolidColorBrush x:Key="Iris.BannerText" Color="#FFB4AB" />
    <SolidColorBrush x:Key="Iris.SwatchBorder" Color="#80FFFFFF" />

    <SolidColorBrush x:Key="Iris.ControlBack" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Iris.ControlBorder" Color="#4A4A4A" />
    <SolidColorBrush x:Key="Iris.ControlHover" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Iris.ControlHoverBorder" Color="#6E6E6E" />
    <SolidColorBrush x:Key="Iris.ControlPressed" Color="#474747" />
    <SolidColorBrush x:Key="Iris.InputBack" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Iris.PopupBack" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Iris.Selection" Color="#264F78" />
    <SolidColorBrush x:Key="Iris.Accent" Color="#3D8FD6" />
    <SolidColorBrush x:Key="Iris.CheckBorder" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Iris.TabBack" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Iris.ScrollThumb" Color="#5A5A5A" />
    <SolidColorBrush x:Key="Iris.ScrollThumbHover" Color="#7A7A7A" />
    <SolidColorBrush x:Key="Iris.SliderTrack" Color="#5A5A5A" />
    <SolidColorBrush x:Key="Iris.FocusLine" Color="#C8C8C8" />

    <Style x:Key="Iris.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" StrokeThickness="1" StrokeDashArray="1 2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Iris.FocusLine}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Iris.Text}" />
        <Setter Property="Background" Value="{DynamicResource Iris.ControlBack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Iris.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Iris.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Iris.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.ControlHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Iris.ControlHoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.ControlPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Iris.Text}" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Iris.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Grid.Column="0" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Iris.ControlBack}" BorderBrush="{DynamicResource Iris.CheckBorder}">
                            <Path x:Name="Mark" Data="M 2.5 7 L 5.5 10 L 11.5 3.5" Stroke="White" StrokeThickness="2"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Iris.ControlHoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Iris.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Iris.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Iris.ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{DynamicResource Iris.ControlBack}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True">
            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Data="M 0 0 L 4 4 L 8 0"
                  Stroke="{DynamicResource Iris.Text}" StrokeThickness="1.5" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.ControlHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.ControlPressed}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Iris.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Iris.ControlBorder}" />
        <Setter Property="Padding" Value="6,3,26,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Iris.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="Toggle" Template="{StaticResource Iris.ComboToggle}" Focusable="False" ClickMode="Press"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="DropDownBorder" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Iris.PopupBack}" BorderBrush="{DynamicResource Iris.ControlBorder}"
                                    BorderThickness="1" SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Iris.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.Selection}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Iris.Text}" />
        <Setter Property="Background" Value="{DynamicResource Iris.InputBack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Iris.ControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Iris.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Iris.Accent}" />
    </Style>
    <Style TargetType="local:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}" />

    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource Iris.Text}" />
        <Setter Property="Background" Value="{DynamicResource Iris.WindowBack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Iris.ControlBorder}" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Iris.Text}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Iris.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Margin="0,0,-1,0" Padding="{TemplateBinding Padding}" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0"
                            Background="{DynamicResource Iris.TabBack}" BorderBrush="{DynamicResource Iris.ControlBorder}" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Focusable="False"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.WindowBack}" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,-2,-1,-1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Iris.TrackPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Iris.ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource Iris.ScrollThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Iris.ScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Iris.VerticalScrollBar" TargetType="ScrollBar">
        <Border Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Iris.TrackPage}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Iris.ScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Iris.TrackPage}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="Iris.HorizontalScrollBar" TargetType="ScrollBar">
        <Border Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" Margin="2">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Iris.TrackPage}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Iris.ScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Iris.TrackPage}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template" Value="{StaticResource Iris.VerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource Iris.HorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Iris.SliderThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Dot" Fill="{DynamicResource Iris.Accent}" Stroke="{DynamicResource Iris.WindowBack}" StrokeThickness="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Iris.Text}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Iris.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Iris.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid MinHeight="22" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="4" Margin="7,0" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Iris.SliderTrack}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Iris.TrackPage}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Iris.SliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Iris.TrackPage}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource Iris.ControlBack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Iris.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Iris.Accent}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Iris.PopupBack}" />
        <Setter Property="Foreground" Value="{DynamicResource Iris.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Iris.ControlBorder}" />
    </Style>

    <Style x:Key="Iris.RuleValueCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasInvalidValue}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Iris.Error}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Iris.Error}" />
                <Setter Property="ToolTip" Value="This value is not in the list of known values. Pick another one." />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Iris.RuleRemoveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
