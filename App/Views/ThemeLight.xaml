<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Static x:Key="Iris.WindowBack" Member="SystemColors.WindowBrush" />
    <x:Static x:Key="Iris.Text" Member="SystemColors.WindowTextBrush" />
    <SolidColorBrush x:Key="Iris.Hint" Color="#616161" />
    <SolidColorBrush x:Key="Iris.Error" Color="#C62828" />
    <SolidColorBrush x:Key="Iris.Note" Color="#B26A00" />
    <SolidColorBrush x:Key="Iris.Valid" Color="#2E7D32" />
    <SolidColorBrush x:Key="Iris.BannerBack" Color="#FDECEA" />
    <SolidColorBrush x:Key="Iris.BannerBorder" Color="#C62828" />
    <SolidColorBrush x:Key="Iris.BannerText" Color="#B71C1C" />
    <SolidColorBrush x:Key="Iris.SwatchBorder" Color="#66000000" />

    <Style x:Key="Iris.RuleValueCombo" TargetType="ComboBox">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasInvalidValue}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Iris.Error}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Iris.Error}" />
                <Setter Property="ToolTip" Value="This value is not in the list of known values. Pick another one." />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Iris.RuleRemoveButton" TargetType="Button">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
