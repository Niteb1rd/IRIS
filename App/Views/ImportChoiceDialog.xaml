<Window x:Class="Iris.App.Views.ImportChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IRIS &#8211; Import config"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource Iris.WindowBack}"
        Foreground="{DynamicResource Iris.Text}"
        ShowInTaskbar="False">

    <StackPanel Margin="16">
        <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel x:Name="ChoicesPanel">
            <TextBlock x:Name="ModeText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2" />
            <TextBlock x:Name="ModeHint" TextWrapping="Wrap" Foreground="{DynamicResource Iris.Hint}" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Iris.Hint}" Margin="0,0,0,8"
                       Text="Change this in Settings, Shared Config, &#8220;When Importing a Config&#8221;." />
            <Button Click="OnImport" Margin="0,0,0,8" Padding="10,6" Content="Import" />
        </StackPanel>

        <StackPanel x:Name="NoExistingPanel" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Iris.Hint}" Margin="0,0,0,8"
                       Text="No saved lists yet: the import becomes your lists." />
            <Button Click="OnImport" Margin="0,0,0,8" Padding="10,6" Content="Import" />
        </StackPanel>

        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Width="90" Padding="0,4" />
    </StackPanel>
</Window>
