<Window x:Class="Iris.App.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Iris.App.Views"
        xmlns:vm="clr-namespace:Iris.App.Views"
        xmlns:rsi="clr-namespace:Iris.Core.Lookup;assembly=Iris.Core"
        xmlns:local="clr-namespace:Iris.App.Views"
        Title="IRIS &#8211; Companion App for Star Citizen"
        Width="890" Height="608"
        MinWidth="750" MinHeight="445"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=FocusSink}"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        Closing="OnWindowClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:OverlayColorToBrushConverter x:Key="ColorToBrush" />
        <conv:StatusKindToBrushConverter x:Key="StatusToBrush" />

        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" Margin="0,0,6,0"
                        CornerRadius="2" BorderThickness="1" BorderBrush="#66000000"
                        Background="{Binding Converter={StaticResource ColorToBrush}}" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StatusCellTemplate">
            <StackPanel Margin="0,4,0,0">
                <DockPanel LastChildFill="True">
                    <ProgressBar DockPanel.Dock="Left" Width="40" Height="6" Margin="0,0,6,0"
                                 VerticalAlignment="Center" IsIndeterminate="True"
                                 Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{Binding StatusKind, Converter={StaticResource StatusToBrush}}" />
                </DockPanel>
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="13" Foreground="#B26A00"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RuleValuePickTemplate">
                <ComboBox IsEditable="False"
                          ItemsSource="{Binding Suggestions}"
                          SelectedItem="{Binding Value}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInvalidValue}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                    <Setter Property="BorderBrush" Value="#C62828" />
                                    <Setter Property="ToolTip" Value="This value is not in the list of known values. Pick another one." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
        </DataTemplate>
        <DataTemplate x:Key="RuleValueInfoTemplate">
            <TextBox IsEnabled="False" IsReadOnly="True"
                     Text="{Binding InfoText, Mode=OneWay}" />
        </DataTemplate>

        <DataTemplate x:Key="RuleTypePickTemplate">
            <ComboBox ItemsSource="{x:Static vm:Choices.Kinds}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Kind"
                      SelectedValue="{Binding Kind}"
                      SelectionChanged="OnRuleKindChanged" />
        </DataTemplate>
        <DataTemplate x:Key="RuleTypeFixedTemplate">
            <TextBox IsEnabled="False" IsReadOnly="True"
                     Text="{Binding KindName, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="RulePriorityPickTemplate">
            <ComboBox ItemsSource="{x:Static vm:Choices.Priorities}"
                      SelectedItem="{Binding Priority}" />
        </DataTemplate>
        <DataTemplate x:Key="RulePriorityFixedTemplate">
            <TextBox IsEnabled="False" IsReadOnly="True"
                     Text="{Binding Priority, Mode=OneWay}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border x:Name="ListBanner" Visibility="Collapsed" Margin="8,8,8,0" Padding="8,6"
                    Background="#FDECEA" BorderBrush="#C62828" BorderThickness="1" CornerRadius="3">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Open file" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Top" Click="OnOpenListFile" />
                    <TextBlock x:Name="ListBannerText" TextWrapping="Wrap" Foreground="#B71C1C" />
                </DockPanel>
            </Border>
            <Border x:Name="SettingsBanner" Visibility="Collapsed" Margin="8,8,8,0" Padding="8,6"
                    Background="#FDECEA" BorderBrush="#C62828" BorderThickness="1" CornerRadius="3">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Open file" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Top" Click="OnOpenSettingsFile" />
                    <TextBlock x:Name="SettingsBannerText" TextWrapping="Wrap" Foreground="#B71C1C" />
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="8,8,8,0" SelectionChanged="OnTabsSelectionChanged">

            <TabItem Header="Players">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#616161"
                               Text="Player names will first be matched against this list. Pick a color for the outline." />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245" />
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Handle" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Color" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PlayersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="245" />
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top" MaxLength="{x:Static rsi:RsiNames.MaxHandleLength}"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 LostKeyboardFocus="OnValueLostFocus"
                                                 PreviewKeyDown="OnNameKeyDown" />
                                        <ComboBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Top"
                                                  ItemsSource="{x:Static vm:Choices.Colors}"
                                                  SelectedItem="{Binding Color}"
                                                  ItemTemplate="{StaticResource ColorItemTemplate}" />
                                        <ContentControl Grid.Column="2" Content="{Binding}"
                                                        ContentTemplate="{StaticResource StatusCellTemplate}" />
                                        <Button Grid.Column="3" Content="&#10005;" ToolTip="Remove this row"
                                                Width="30" Height="28" VerticalAlignment="Top"
                                                Click="OnRemoveRow" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="+ Add player" HorizontalAlignment="Left"
                            Padding="12,4" Margin="0,8,0,0" Click="OnAddPlayer" />
                </Grid>
            </TabItem>

            <TabItem Header="Orgs">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#616161"
                               Text="If player is in org, use selected color. Priority number used for tiebreaks 1=highest. Last tiebreak is entry order." />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SID" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Priority" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Color" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="OrgsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="175" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top" MaxLength="40"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 LostKeyboardFocus="OnValueLostFocus"
                                                 PreviewKeyDown="OnNameKeyDown" />
                                        <ComboBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Top"
                                                  ItemsSource="{x:Static vm:Choices.Priorities}"
                                                  SelectedItem="{Binding Priority}" />
                                        <ComboBox Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Top"
                                                  ItemsSource="{x:Static vm:Choices.Colors}"
                                                  SelectedItem="{Binding Color}"
                                                  ItemTemplate="{StaticResource ColorItemTemplate}" />
                                        <ContentControl Grid.Column="3" Content="{Binding}"
                                                        ContentTemplate="{StaticResource StatusCellTemplate}" />
                                        <Button Grid.Column="4" Content="&#10005;" ToolTip="Remove this row"
                                                Width="30" Height="28" VerticalAlignment="Top"
                                                Click="OnRemoveRow" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="+ Add org" HorizontalAlignment="Left"
                            Padding="12,4" Margin="0,8,0,0" Click="OnAddOrg" />
                </Grid>
            </TabItem>

            <TabItem Header="Org-Attribute">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#616161"
                               Text="If name is not in previous two lists, use these general rules. The last row, No Match, colors every other detected player." />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="*" MinWidth="175" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Type" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Priority" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Color" FontWeight="SemiBold" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="152" />
                                            <ColumnDefinition Width="*" MinWidth="175" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top"
                                                        HorizontalContentAlignment="Stretch" Focusable="False"
                                                        Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource RuleTypePickTemplate}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource RuleTypeFixedTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <ContentControl Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Top"
                                                        HorizontalContentAlignment="Stretch" Focusable="False"
                                                        Tag="RuleValueCell"
                                                        Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource RuleValueInfoTemplate}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsValue}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource RuleValuePickTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <ContentControl Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Top"
                                                        HorizontalContentAlignment="Stretch" Focusable="False"
                                                        Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource RulePriorityPickTemplate}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource RulePriorityFixedTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <ComboBox Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Top"
                                                  ItemsSource="{x:Static vm:Choices.Colors}"
                                                  SelectedItem="{Binding Color}"
                                                  ItemTemplate="{StaticResource ColorItemTemplate}" />
                                        <Button Grid.Column="4" Content="&#10005;" ToolTip="Remove this row"
                                                Width="30" Height="28" VerticalAlignment="Top"
                                                Click="OnRemoveRow">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="+ Add rule" HorizontalAlignment="Left"
                            Padding="12,4" Margin="0,8,0,0" Click="OnAddRule" />
                </Grid>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Foreground="#616161"
                                   Text="App settings for this PC. These are not included in the exported config." />

                        <CheckBox x:Name="CheckForUpdatesCheck" Content="Check for updates on app start (api.github.com)" Margin="0,0,0,16"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                        <TextBlock Text="Hotkeys" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,6"
                                   Text="Key combinations with Ctrl, Alt, Shift allowed." />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175" />
                                <ColumnDefinition Width="270" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Toggle Overlay" VerticalAlignment="Center" />
                            <local:HotkeyBox x:Name="OverlayHotkeyBox" Grid.Row="0" Grid.Column="1" Margin="0,2" Padding="4,2"
                                             HotkeyChanged="OnHotkeyBoxChanged" />
                            <Button x:Name="ClearOverlayHotkeyButton" Grid.Row="0" Grid.Column="2" Content="Clear" Padding="10,2" Margin="8,2,0,2"
                                    Click="OnClearOverlayHotkey" />
                            <TextBlock x:Name="OverlayHotkeyError" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Foreground="#C62828"
                                       TextWrapping="Wrap" Visibility="Collapsed" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Toggle Info Panel" VerticalAlignment="Center" />
                            <local:HotkeyBox x:Name="PanelHotkeyBox" Grid.Row="2" Grid.Column="1" Margin="0,2" Padding="4,2"
                                             HotkeyChanged="OnHotkeyBoxChanged" />
                            <Button x:Name="ClearPanelHotkeyButton" Grid.Row="2" Grid.Column="2" Content="Clear" Padding="10,2" Margin="8,2,0,2"
                                    Click="OnClearPanelHotkey" />
                            <TextBlock x:Name="PanelHotkeyError" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Foreground="#C62828"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                        </Grid>

                        <TextBlock Text="Logging" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox x:Name="LogEnabledCheck" Content="Write a log file (Logs folder)" Margin="0,0,0,6"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        <Button x:Name="OpenLogFolderButton" Content="Open log folder" HorizontalAlignment="Left"
                                Padding="12,4" Margin="0,0,0,16" Click="OnOpenLogFolder" />

                        <TextBlock Text="Shared Config" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <Button x:Name="ImportFileButton" Content="Import from file&#8230;" Padding="12,4" Margin="0,0,8,0" Click="OnImportFromFile" />
                            <Button x:Name="ExportButton" Content="Export&#8230;" Padding="12,4" Click="OnExport" />
                        </StackPanel>
                        <TextBlock Text="Hosted Config URL" Margin="0,0,0,2" />
                        <TextBox x:Name="HostedUrlBox" MaxLength="2000" LostKeyboardFocus="OnHostedUrlLostFocus" TextChanged="OnHostedUrlTextChanged" />
                        <TextBlock x:Name="HostedUrlError" Foreground="#C62828" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Button x:Name="ImportUrlButton" Content="Import from URL" Padding="12,4" Margin="0,0,12,0" VerticalAlignment="Center" Click="OnImportFromUrl"
                                    ToolTip="Fetches the hosted config. If it is the same version you imported last time, nothing is imported." />
                            <CheckBox x:Name="HostedAutoCheck" VerticalAlignment="Center"
                                      Content="Check URL for updates" IsEnabled="False"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                                      ToolTip="Checks the address once a day while IRIS runs and asks before importing a changed file." />
                        </StackPanel>

                        <Button x:Name="TestOverlayButton" Content="Show Test Overlay" HorizontalAlignment="Left"
                                Padding="12,4" Margin="0,16,0,0" Click="OnTestOverlay" />

                        <TextBlock Text="Tracking Boundary" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,6"
                                   Text="Looks for player in defined area. Note: Active videos other than Star Citizen can cause detection issues." />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="258" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Top" VerticalAlignment="Center" />
                            <Slider x:Name="BoundaryTopSlider" Grid.Row="0" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=BoundaryTopSlider, StringFormat='{}{0:0}%'}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bottom" VerticalAlignment="Center" />
                            <Slider x:Name="BoundaryBottomSlider" Grid.Row="1" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=BoundaryBottomSlider, StringFormat='{}{0:0}%'}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Left" VerticalAlignment="Center" />
                            <Slider x:Name="BoundaryLeftSlider" Grid.Row="2" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=BoundaryLeftSlider, StringFormat='{}{0:0}%'}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Right" VerticalAlignment="Center" />
                            <Slider x:Name="BoundaryRightSlider" Grid.Row="3" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=BoundaryRightSlider, StringFormat='{}{0:0}%'}" />
                        </Grid>

                        <TextBlock Text="Overlay" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="258" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Panel Width" VerticalAlignment="Center" />
                            <Slider x:Name="PanelWidthSlider" Grid.Row="0" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=PanelWidthSlider, StringFormat='{}{0:0}%'}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Text Size" VerticalAlignment="Center" />
                            <Slider x:Name="PanelTextSizeSlider" Grid.Row="1" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=PanelTextSizeSlider, StringFormat='{}{0:0} px'}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Right Gap" VerticalAlignment="Center" />
                            <Slider x:Name="PanelRightGapSlider" Grid.Row="2" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=PanelRightGapSlider, StringFormat='{}{0:0}%'}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Top Gap" VerticalAlignment="Center" />
                            <Slider x:Name="PanelTopGapSlider" Grid.Row="3" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=PanelTopGapSlider, StringFormat='{}{0:0}%'}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Nameplate Tracking Tickrate" VerticalAlignment="Center" />
                            <Slider x:Name="TrackingFpsSlider" Grid.Row="4" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="15"
                                    ValueChanged="OnTrackingFpsSliderChanged" />
                            <TextBlock x:Name="TrackingFpsLabel" Grid.Row="4" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox x:Name="OverlayVisibleInCaptureCheck" Content="Show overlay in screenshots and recordings" Margin="0,0,0,8"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged" Click="OnVisibleInCaptureClick" />
                        <CheckBox x:Name="HideCaptureBorderCheck" Content="Hide yellow capture border (Windows asks once)" Margin="0,0,0,8"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Windows 11 only. Asks Windows to drop the yellow border it draws around captured windows; Windows asks you once to allow it." />

                        <TextBlock Text="Cache" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Refresh cached RSI data after" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CacheTtlCombo" Width="117" SelectedIndex="0" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="30 days" />
                                <ComboBoxItem Content="7 days" />
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="RefreshCacheButton" Content="Refresh Cache (long)" HorizontalAlignment="Left"
                                Padding="12,4" Margin="0,0,0,8" Click="OnRefreshCache" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="FocusSink" Grid.Column="0" Width="1" Height="1" HorizontalAlignment="Left"
                    Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False" />
            <TextBlock x:Name="FooterStatus" Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="Save" Width="94" Padding="0,4" IsEnabled="False" Click="OnSave" />
            <Button Grid.Column="2" Content="Close" Width="94" Padding="0,4" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
